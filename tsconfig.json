{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@catalog": [
        "./catalog/index.ts"
      ]
    }
  },
  "include": [
    "platform",
    "runtimes",
    "apps",
    "missions",
    "catalog",
    "tests",
    "scripts",
    "*.config.ts",
    "*.config.mjs"
  ]
}
