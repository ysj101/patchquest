{
  "name": "patchquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ブラウザ上の教材アプリに脆弱性を課題パックとして注入して学ぶ学習プラットフォーム",
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:external": "node scripts/check-external-refs.mjs dist",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/build.mjs --test && playwright test",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory dist",
    "verify:packs": "node scripts/build.mjs --test && playwright test tests/e2e/pack-verification.spec.ts --project chrome",
    "package": "node scripts/package.mjs",
    "test:dist": "node scripts/test-dist.mjs",
    "check:duplication": "jscpd --baseline-from-ref origin/main --fail-on-new-clones",
    "audit:duplication": "jscpd --blame --reporters console-full,html",
    "check:unused": "knip",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run check:boundaries && pnpm run check:duplication && pnpm run check:unused && pnpm run test:coverage",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2"
  }
}
