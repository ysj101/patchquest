#!/bin/sh
# visudo が呼ぶエディタ。画面は持たない。編集（操作<TAB>行番号<TAB>内容。操作は r 書き換え・d 削除・a 下に追加。
# 行番号は開いたときのもの）が届いていれば当てはめ、
# 届いていなければ中身を学習画面の編集画面へ渡して、何も変えずに閉じる。結果（opened・applied・same・range）を書き残す
Q=/run/pq
for file; do :; done
if [ ! -f "$Q/edits" ]; then
  { readlink -f "${file%.tmp}"; cat "$file"; } > "$Q/editor.dump"
  printf opened > "$Q/editor.result"
  exit 0
fi
awk -v edits="$Q/edits" '
  BEGIN {
    while ((getline row < edits) > 0) {
      op = substr(row, 1, 1); rest = substr(row, 3); tab = index(rest, "\t"); n = substr(rest, 1, tab - 1) + 0; value = substr(rest, tab + 1)
      if (op == "r") text[n] = value; else if (op == "d") gone[n] = 1; else added[n] = added[n] value "\n"
      if (n > last) last = n
    }
    printf "%s", added[0]
  }
  { if (!(FNR in gone)) print (FNR in text) ? text[FNR] : $0; printf "%s", added[FNR] }
  END { if (last > NR) { printf "visudo: 行番号は 1〜%d で指定してください（指定：%d）\n", NR, last > "/dev/stderr"; exit 2 } }
' "$file" > "$file.pq" || { rm -f "$file.pq"; printf range > "$Q/editor.result"; exit 2; }
if cmp -s "$file" "$file.pq"; then printf same > "$Q/editor.result"; else printf applied > "$Q/editor.result"; fi
cat "$file.pq" > "$file"
rm -f "$file.pq"
