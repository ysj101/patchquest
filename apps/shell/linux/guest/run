#!/bin/sh
# 利用者として、要求された場所でコマンド行を実行する。終了コードと終わったときの場所を、3 番の出力へ書き残す
trap 'printf "%s\n%s\n" "$?" "$PWD" >&3' EXIT
# visudo と sudoedit が開くエディタ。画面を持つエディタ（vi）は、この端末では入力を受け取れない
export EDITOR=/usr/lib/pq/editor VISUAL=/usr/lib/pq/editor SUDO_EDITOR=/usr/lib/pq/editor
# git status や git diff は、調べるだけでも、作業の覚え（.git/index）を書き直すことがある。調べただけで機械の状態が変わったことにならないよう、
# 書き直しをやめさせる（どちらも git に元からある設定。status は GIT_OPTIONAL_LOCKS、diff は diff.autoRefreshIndex）。
# git add や git commit は、今までどおり書く
export GIT_OPTIONAL_LOCKS=0 GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=diff.autoRefreshIndex GIT_CONFIG_VALUE_0=false
# シェルの組み込みの help は、組み込みコマンドの名前を並べるだけで、調べるのに使うコマンド（cat や sudo）が出てこない。
# 「端末の使い方」が help を勧めているので、この端末でよく使うコマンドの案内に差し替える
help() { cat /usr/lib/pq/help; }
# 画面を持つエディタ（vi）は、この端末では入力を受け取れず、画面を描く制御文字だけを出して終わる。
# 対話的なプログラムには対応しないので（Issue #172）、使えないことと、代わりの方法を伝える
vi() { echo 'vi: この端末では、画面全体を使うプログラムは動きません。ファイルを見るには cat 名前、設定のファイルを直すには sudoedit 名前（sudo の設定は sudo visudo -f 名前）を使います' >&2; return 1; }
IFS= read -r cwd < /run/pq/cwd
cd "$cwd" || exit 1
. /run/pq/line
